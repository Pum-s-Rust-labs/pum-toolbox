# Application
APP_NAME=pum-toolbox
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8080
RUST_LOG=info,pum_api=debug,pum_modules=debug

# PostgreSQL connection string (URL-encode special characters in password, e.g. '+' -> '%2B')
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=prefer

# Security & Auth (change to a strong 64+ char random secret in production)
JWT_SECRET=replace-with-a-very-long-random-secret-key-at-least-32-bytes
JWT_ACCESS_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Initial SuperAdmin account bootstrapped automatically if database has no users
BOOTSTRAP_ADMIN_EMAIL=admin@pumlabs.dev
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026Strong

# Uptime worker & Image limits
ALLOW_PRIVATE_MONITOR_TARGETS=false
MAX_UPLOAD_MB=15
